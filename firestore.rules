rules_version = '2';

// Hisab Indane Gas Agency — production-oriented Firestore Security Rules
// Authorization for privileged writes is enforced in Cloud Functions (Admin SDK).
// Client SDK may only perform the narrow reads/updates documented below.
// Role checks use Firebase Auth custom claims (request.auth.token.role), never client-writable profile fields.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isStaff() {
      return signedIn() && request.auth.token.role == 'staff';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveAgencyUser() {
      return isAdmin() || isStaff();
    }

    function staffProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function staffPermissionTrue(permission) {
      return isStaff()
        && staffProfile().status == 'active'
        && staffProfile().permissions[permission] == true;
    }

    function canViewCustomers() {
      return isAdmin() || staffPermissionTrue('customers.view');
    }

    function canViewGodown() {
      return isAdmin() || staffPermissionTrue('godown.view');
    }

    function canViewInventory() {
      return isAdmin() || staffPermissionTrue('inventory.view');
    }

    // Registered godown sales need customer master lookup without granting the Customers module.
    function canReadCustomerMaster() {
      return canViewCustomers() || canViewGodown();
    }

    // Self-service profile edits: language only. Identity, role, status, permissions,
    // phone, synthetic auth email, and password-change flags are Admin SDK / Functions only.
    function isLanguageOnlySelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language', 'updatedAt'])
        && request.resource.data.language in ['en', 'hi']
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.phoneE164 == resource.data.phoneE164
        && request.resource.data.authEmail == resource.data.authEmail
        && request.resource.data.mustChangePassword == resource.data.mustChangePassword
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // -------------------------------------------------------------------------
    // users — profiles mirrored from Auth; created/updated by Admin SDK Functions
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isAdmin() || isSelf(userId);
      allow list: if isAdmin();

      allow update: if isActiveAgencyUser() && isSelf(userId) && isLanguageOnlySelfUpdate();

      allow create, delete: if false;
    }

    // -------------------------------------------------------------------------
    // settings — agency config is readable by signed-in users; all writes via Admin SDK
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow get: if isActiveAgencyUser() && docId == 'agency';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Agency master data configured in Phase 1 Settings (writes via Admin SDK Functions).
    match /locations/{id} {
      allow read: if isActiveAgencyUser();
      allow create, update, delete: if false;
    }

    match /products/{id} {
      allow read: if isActiveAgencyUser();
      allow create, update, delete: if false;
    }

    match /priceRules/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // customers — Phase 2 Customer Master (writes via Admin SDK Functions only)
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read: if canReadCustomerMaster();
      allow create, update, delete: if false;
    }

    match /customerImportBatches/{batchId} {
      allow read: if canViewCustomers();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Operational / ledger collections (Phase 1+ foundation)
    // Client writes are denied. Posting, approvals, godown exceptions, reversals,
    // and inventory/finance mutations must go through Cloud Functions.
    // -------------------------------------------------------------------------
    match /transactions/{id} {
      // Godown and inventory modules both read transactions (inventory pending queue / ledger links).
      allow read: if canViewGodown() || canViewInventory();
      allow create, update, delete: if false;
    }

    match /idempotencyRecords/{id} {
      allow read, create, update, delete: if false;
    }

    function financePublication() {
      return get(/databases/$(database)/documents/financePublication/current).data;
    }

    function publicationPointerLive() {
      return financePublication().publishedSessionId is string
        && financePublication().publishedGenerationId is string;
    }

    function openingRecordVisible() {
      return publicationPointerLive()
        && resource.data.recordScope == 'opening'
        && resource.data.openingSessionId == financePublication().publishedSessionId
        && resource.data.openingGenerationId == financePublication().publishedGenerationId;
    }

    function operationalLedgerVisible() {
      return resource.data.recordScope == 'operational';
    }

    function balanceMatchesPointer() {
      return publicationPointerLive()
        && resource.data.publishedSessionId == financePublication().publishedSessionId
        && resource.data.publishedGenerationId == financePublication().publishedGenerationId;
    }

    match /financialLedger/{id} {
      // Admin-only in Phase 5.0. Queries must constrain recordScope (+ opening session/generation).
      allow get: if isAdmin() && (operationalLedgerVisible() || openingRecordVisible());
      allow list: if isAdmin() && (operationalLedgerVisible() || openingRecordVisible());
      allow create, update, delete: if false;
    }

    match /financialBalances/{id} {
      // Aggregate projection — not recordScope. Admin-only; must match publication pointer.
      allow get: if isAdmin() && balanceMatchesPointer();
      allow list: if isAdmin() && balanceMatchesPointer();
      allow create, update, delete: if false;
    }

    match /financePublication/{id} {
      allow get: if isAdmin() && id == 'current';
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /financialOpeningGate/{id} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /openingSessions/{id} {
      allow read, write: if false;
    }

    match /openingSessions/{id}/{document=**} {
      allow read, write: if false;
    }

    match /openingPlans/{id} {
      allow read, write: if false;
    }

    match /openingChunks/{id} {
      allow read, write: if false;
    }

    match /openingChunkCompletions/{id} {
      allow read, write: if false;
    }

    match /openingReceivableReviews/{id} {
      allow read, write: if false;
    }

    match /openingBalanceSheets/{id} {
      allow read, write: if false;
    }

    match /openingRollups/{id} {
      allow read, write: if false;
    }

    match /openingCollectionSnapshots/{id} {
      allow get: if isAdmin() && openingRecordVisible();
      allow list: if isAdmin() && openingRecordVisible();
      allow create, update, delete: if false;
    }

    match /saleCutoverRecords/{id} {
      allow get: if isAdmin() && (operationalLedgerVisible() || openingRecordVisible());
      allow list: if isAdmin() && (operationalLedgerVisible() || openingRecordVisible());
      allow create, update, delete: if false;
    }

    match /financeCutoverCandidates/{id} {
      allow read, write: if false;
    }

    match /moneyObligationOriginClaims/{id} {
      allow read, write: if false;
    }

    match /moneyObligationLinkClaims/{id} {
      allow read, write: if false;
    }

    match /paymentAllocations/{id} {
      allow read, write: if false;
    }

    match /creditApplications/{id} {
      allow read, write: if false;
    }

    match /reconciliationEvents/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /inventoryLedger/{id} {
      allow read: if canViewInventory();
      allow create, update, delete: if false;
    }

    match /inventoryBalances/{id} {
      allow read: if canViewInventory();
      allow create, update, delete: if false;
    }

    match /inventoryOpenings/{id} {
      allow read: if canViewInventory();
      allow create, update, delete: if false;
    }

    match /obligations/{id} {
      // Empty-cylinder obligations keep Godown visibility. Money/opening kinds are Admin-only with scope checks.
      allow get: if (resource.data.kind == 'empty_cylinder' && canViewGodown())
        || (isAdmin() && resource.data.kind == 'money' && (
          !('recordScope' in resource.data)
          || resource.data.recordScope == 'operational'
          || openingRecordVisible()
        ));
      allow list: if (resource.data.kind == 'empty_cylinder' && canViewGodown())
        || (isAdmin() && resource.data.kind == 'money' && (
          !('recordScope' in resource.data)
          || resource.data.recordScope == 'operational'
          || openingRecordVisible()
        ));
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default deny — unmatched paths and unknown collections
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
