# Copy to .env.local. Vite exposes only VITE_* variables to the browser.
# Firebase web config is public client configuration. Security is enforced by Auth,
# Firestore rules, and Cloud Functions. Never put an Admin SDK private key here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hisab-9d3e4
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Used only by bootstrap/migrate scripts. Not bundled into the web app.
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=

# Optional: when migrating an existing admin, set to also rotate the password.
# MIGRATE_SET_PASSWORD=
